# Copy to .env and fill in the blanks. Do not commit .env.

# CINECA/LEONARDO username (part before the "@")
LEONARDO_SUPERCOMPUTER_SSH_USERNAME=
# Identity-provider password (used during `step ssh login`; hackathon: no 2FA)
LEONARDO_SUPERCOMPUTER_SSH_PASSWORD=
# Login node: login01/02/05/07-ext.leonardo.cineca.it
LEONARDO_SUPERCOMPUTER_SSH_HOST=login05-ext.leonardo.cineca.it

# GitHub token with repo read access (use git on a login node — no internet on compute nodes)
GITHUB_PERSONAL_TOKEN=
# Project repository URL
GITHUB_PROJECT_URL=https://github.com/Julian-AT/zero_one_hack_01